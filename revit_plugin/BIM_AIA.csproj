    <LangVersion>12</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>BIM_AIA</AssemblyName>
    <RootNamespace>BIM_AIA</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
