<Window x:Class="BIM_AIA.Views.AuditChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM AIA - Visual Inspection &amp; Audit Log" 
        Height="560" Width="760" 
        WindowStartupLocation="CenterScreen"
        Background="#181825"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI, Tahoma"
        Topmost="True">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Changes List -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Width="40" Height="40" Background="#10B981" CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="👁️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Visual Inspection &amp; Audit of Model Changes" FontWeight="Bold" FontSize="15" Foreground="#89B4FA"/>
                    <TextBlock Text="Double-click any row to automatically jump to dedicated 3D view with element isolation &amp; glow." FontSize="11" Foreground="#A6ADC8"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Changes List View -->
        <Border Grid.Row="1" Background="#11111B" CornerRadius="8" Padding="4" Margin="0,0,0,12">
            <ListView x:Name="ListChanges" Background="Transparent" BorderThickness="0" Foreground="#CDD6F4"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="ListChanges_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time" Width="75" DisplayMemberBinding="{Binding FormattedTime}"/>
                        <GridViewColumn Header="Category" Width="100" DisplayMemberBinding="{Binding Category}"/>
                        <GridViewColumn Header="Element ID" Width="95" DisplayMemberBinding="{Binding ElementIdString}"/>
                        <GridViewColumn Header="Operation" Width="180" DisplayMemberBinding="{Binding ChangeType}"/>
                        <GridViewColumn Header="Description &amp; Values" Width="260" DisplayMemberBinding="{Binding Description}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="BtnInspectSelected" Click="BtnInspectSelected_Click" Background="#89B4FA" Foreground="#11111B" Height="36" Padding="14,0" Margin="0,0,8,0">
                    <TextBlock Text="🎯 Jump to 3D View &amp; Highlight" FontWeight="Bold"/>
                </Button>
                <Button x:Name="BtnScanModel" Click="BtnScanModel_Click" Background="#313244" Height="36" Padding="12,0">
                    <TextBlock Text="🔄 Scan Model Elements"/>
                </Button>
            </StackPanel>
            <Button DockPanel.Dock="Right" x:Name="BtnClose" Click="BtnClose_Click" Background="#313244" Height="36" Padding="14,0">
                <TextBlock Text="Close"/>
            </Button>
        </DockPanel>
    </Grid>
</Window>
