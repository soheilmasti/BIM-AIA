<Window x:Class="BIM_AIA.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM AIA - Senior AI Copilot for Autodesk Revit 2026" 
        Height="780" Width="1080" 
        MinHeight="620" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#181825"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI, Tahoma">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#313244"/>
            <Setter Property="RowBackground" Value="#1E1E2E"/>
            <Setter Property="AlternatingRowBackground" Value="#252538"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#11111B"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#313244"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header & Project Context -->
            <RowDefinition Height="220"/>  <!-- 1: Model Changes DataGrid -->
            <RowDefinition Height="Auto"/> <!-- 2: Action Bridge & Quick Chips -->
            <RowDefinition Height="*"/>    <!-- 3: AI Copilot & Console -->
            <RowDefinition Height="Auto"/> <!-- 4: Footer -->
        </Grid.RowDefinitions>

        <!-- 0: Header & Project Context -->
        <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="⚡ BIM AIA Copilot" FontSize="18" FontWeight="Bold" Foreground="#89B4FA"/>
                        <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="● Live Revit Connected" FontSize="11" Foreground="#34D399" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtProjectHeader" Text="Project: Detecting active model..." Foreground="#A6ADC8" FontSize="12" Margin="0,0,15,0"/>
                        <TextBlock x:Name="TxtViewHeader" Text="Active View: Reading..." Foreground="#6C7086" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="BtnRescan" Content="🔄 Scan / Refresh Model" Click="BtnRescan_Click" Margin="0,0,8,0" Background="#313244"/>
                    <Button x:Name="BtnInspectSelected" Content="🎯 Jump to 3D View" Click="BtnInspectSelected_Click" Background="#89B4FA" Foreground="#11111B"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: Model Elements & Changes DataGrid -->
        <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="8" Padding="8" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="4,2,4,8">
                    <TextBlock Text="📋 Model Elements &amp; Change Log (Double-click any row to isolate &amp; highlight in 3D view)" 
                               Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="TxtChangesCount" Text="Items: 0" Foreground="#89B4FA" FontSize="11" DockPanel.Dock="Right"/>
                </DockPanel>

                <DataGrid x:Name="GridChanges" Grid.Row="1" AutoGenerateColumns="False" 
                          IsReadOnly="True" SelectionMode="Single"
                          MouseDoubleClick="GridChanges_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Element ID" Binding="{Binding ElementIdString}" Width="100"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="Operation / Action" Binding="{Binding ChangeType}" Width="200"/>
                        <DataGridTextColumn Header="Details / Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Before" Binding="{Binding BeforeValue}" Width="80"/>
                        <DataGridTextColumn Header="After" Binding="{Binding AfterValue}" Width="90"/>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding FormattedTime}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 2: Dynamic Generative MEP Control Bar & Action Bridge -->
        <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row A: Generative MEP Controls -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="🎯 Level:" Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="CmbTargetLevel" Width="120" Height="26" Margin="0,0,10,0" 
                                  DisplayMemberPath="Name" SelectionChanged="CmbTargetLevel_SelectionChanged"
                                  ToolTip="Dynamically loaded from active Revit model"/>

                        <TextBlock Text="⚡ Discipline:" Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="CmbDiscipline" Width="145" Height="26" Margin="0,0,10,0" SelectedIndex="0">
                            <ComboBoxItem Content="⚡ Electrical (Power &amp; Light)"/>
                            <ComboBoxItem Content="❄️ Mechanical (HVAC Ducts)"/>
                            <ComboBoxItem Content="🚰 Plumbing (Drain &amp; Slope)"/>
                            <ComboBoxItem Content="🌐 Multi-Discipline MEP"/>
                        </ComboBox>

                        <TextBlock Text="🏢 Scope / Space:" Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="CmbRoomScope" Width="175" Height="26" Margin="0,0,10,0"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="Target all rooms, current selection, or a specific space"/>

                        <Button x:Name="BtnRunGenerativeMep" Content="⚡ Design &amp; Analyze MEP" 
                                Click="BtnRunGenerativeMep_Click" 
                                Background="#FACC15" Foreground="#11111B" FontWeight="Bold" Padding="12,5"/>
                    </StackPanel>

                    <Button x:Name="BtnApplySuggestedAction" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Content="⚡ Apply AI Recommendation in Model" Visibility="Collapsed"
                            Click="BtnApplySuggestedAction_Click"
                            Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" Padding="14,5"/>
                </DockPanel>

                <!-- Row B: Quick Action Chips -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Quick Tools:" Foreground="#6C7086" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="🔄 Offset/Reroute (-300mm)" Click="QuickAction_Reroute_Click" Margin="0,0,6,0" Padding="8,4" FontSize="10"/>
                    <Button Content="📐 Pipe Slope (1.5%)" Click="QuickAction_Slope_Click" Margin="0,0,6,0" Padding="8,4" FontSize="10"/>
                    <Button Content="🏷️ Uniclass Metadata" Click="QuickAction_Uniclass_Click" Margin="0,0,6,0" Padding="8,4" FontSize="10"/>
                    <Button Content="🔍 Clash Audit &amp; Highlight" Click="QuickAction_Audit_Click" Margin="0,0,6,0" Padding="8,4" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3: AI Copilot Interaction & Log Console -->
        <Border Grid.Row="3" Background="#1E1E2E" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mode selector -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="💬 BIM AIA Engineering Consultant:" FontWeight="Bold" FontSize="13" Foreground="#F9E2AF" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <RadioButton x:Name="RadioConsult" Content="💡 Consultation (Read-Only)" Foreground="#89B4FA" FontSize="11" Margin="0,0,15,0" IsChecked="False"/>
                        <RadioButton x:Name="RadioExecute" Content="⚡ Direct CAD Execution (Modify Model)" Foreground="#A6E3A1" FontSize="11" FontWeight="Bold" IsChecked="True"/>
                    </StackPanel>
                </DockPanel>

                <!-- Console / Chat log -->
                <TextBox x:Name="TxtConsoleLog" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto" Background="#11111B" Foreground="#CDD6F4" 
                         BorderThickness="0" Padding="10" FontSize="12" FontFamily="Consolas, Segoe UI"
                         Margin="0,0,0,10"/>

                <!-- Prompt Input Bar -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPromptInput" Height="36" Padding="10,8" Background="#313244" Foreground="#CDD6F4" 
                             BorderThickness="0" FontSize="12" VerticalContentAlignment="Center"
                             KeyDown="TxtPromptInput_KeyDown" Text=""/>
                    <Button x:Name="BtnSendPrompt" Grid.Column="1" Content="Send Command" Width="110" Margin="8,0,0,0" 
                            Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Click="BtnSendPrompt_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 4: Footer with Self-Healing Badge -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                    <TextBlock Text="🛡️ AI Self-Healing Engine: ACTIVE" Foreground="#34D399" FontSize="11" FontWeight="Bold"/>
                </Border>
                <TextBlock x:Name="TxtStatusHint" Text="Revit API runtime exceptions are automatically diagnosed, neutralized and healed." Foreground="#6C7086" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1" Content="Close" Width="70" Click="BtnClose_Click" Background="#313244"/>
        </Grid>
    </Grid>
</Window>
